# Variables de entorno de ROBAC. Copia este archivo a .env (no se sube a GitHub)
# o configúralas en el servicio donde se publique el sistema.

# Servidor
HOST=0.0.0.0
PORT=3001
ROBAC_DB=./data/robac.db

# Correo para el código de recuperación (si no hay SMTP_HOST, el código sale en la consola)
SMTP_HOST=smtp.ejemplo.mx
SMTP_PUERTO=587
# true para TLS directo (puerto 465); con 587 se usa STARTTLS
SMTP_SEGURO=false
SMTP_USUARIO=avisos@ejemplo.mx
SMTP_CLAVE=
SMTP_REMITENTE=avisos@ejemplo.mx
