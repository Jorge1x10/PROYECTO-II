# Variables de entorno de ROBAC. Copia este archivo a .env (no se sube a GitHub) y arranca
# con: node --env-file=.env server/index.js
# o configúralas en el servicio donde se publique el sistema.

# Servidor
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
ROBAC_DB=./data/robac.db

# Primer administrador (solo se usa al crear la base; sin él no hay cuentas de prueba)
ROBAC_ADMIN_CORREO=admin@ejemplo.mx
ROBAC_ADMIN_CLAVE=
ROBAC_ADMIN_NOMBRE=Administrador

# Respaldos de la base de datos (0 los desactiva)
ROBAC_RESPALDO_HORAS=24
ROBAC_RESPALDOS=./data/respaldos

# Correo para el código de recuperación (si no hay SMTP_HOST, el código sale en la consola)
SMTP_HOST=smtp.ejemplo.mx
SMTP_PUERTO=587
# true para TLS directo (puerto 465); con 587 se usa STARTTLS
SMTP_SEGURO=false
SMTP_USUARIO=avisos@ejemplo.mx
SMTP_CLAVE=
SMTP_REMITENTE=avisos@ejemplo.mx
